{# templates/salle/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des salles{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestion des salles</h1>
    <a href="{{ path('app_salle_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter une salle
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Capacité</th>
                <th>Localisation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for salle in salles %}
            <tr>
                <td>{{ salle.code }}</td>
                <td>{{ salle.capacite }}</td>
                <td>{{ salle.localisation }}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a href="{{ path('app_salle_edit', {id: salle.id}) }}"
                           class="btn btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST" action="{{ path('app_salle_delete', {id: salle.id}) }}"
                              onsubmit="return confirm('Supprimer cette salle ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ salle.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="text-center">Aucune salle enregistrée</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
