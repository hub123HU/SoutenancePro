{# templates/enseignant/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des enseignants{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestion des enseignants</h1>
    <a href="{{ path('app_enseignant_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter un enseignant
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Spécialité</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for enseignant in enseignants %}
            <tr>
                <td>{{ enseignant.nom }}</td>
                <td>{{ enseignant.prenom }}</td>
                <td>{{ enseignant.email }}</td>
                <td>{{ enseignant.specialite }}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a href="{{ path('app_enseignant_edit', {id: enseignant.id}) }}"
                           class="btn btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST" action="{{ path('app_enseignant_delete', {id: enseignant.id}) }}"
                              onsubmit="return confirm('Supprimer cet enseignant ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignant.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun enseignant enregistré</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
