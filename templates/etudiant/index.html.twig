{# templates/etudiant/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des étudiants{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestion des étudiants</h1>
    <a href="{{ path('app_etudiant_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter un étudiant
    </a>
</div>

<!-- Recherche -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-10">
                <input type="text" name="search" class="form-control" 
                       placeholder="Rechercher par nom..." value="{{ search|default('') }}">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Filière</th>
                <th>Thème du mémoire</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for etudiant in etudiants %}
            <tr>
                <td>{{ etudiant.nom }}</td>
                <td>{{ etudiant.prenom }}</td>
                <td>{{ etudiant.email }}</td>
                <td>{{ etudiant.filiere }}</td>
                <td>{{ etudiant.themeMemoire }}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a href="{{ path('app_etudiant_edit', {id: etudiant.id}) }}" 
                           class="btn btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST" action="{{ path('app_etudiant_delete', {id: etudiant.id}) }}" 
                              onsubmit="return confirm('Supprimer cet étudiant ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="text-center">Aucun étudiant enregistré</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}